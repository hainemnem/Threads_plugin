{
  "manifest_version": 3,
  "name": "Threads Read Counter",
  "version": "1.0.0",
  "description": "Counts how many Threads posts are visible/read in the feed.",
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.net/*",
        "https://threads.net/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
